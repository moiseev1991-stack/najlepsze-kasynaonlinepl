# Plesk: document root = /httpdocs, statyczny Next leży w /httpdocs/site/
# Ten plik musi leżeć w katalogu głównym repozytorium (po deploy: httpdocs/.htaccess).
# Usuń domyślny index.html z Pleska w httpdocs (README) — nie używaj DirectoryIndex disabled,
# bo psuje index.html w podkatalogach przy document root = httpdocs/site/.

ErrorDocument 404 /site/404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Kanonizacja hosta: www → non-www 301 (jedna kanoniczna wersja serwisu)
  RewriteCond %{HTTP_HOST} ^www\.najlepsze-kasynaonline\.com\.pl$ [NC]
  RewriteRule ^(.*)$ https://najlepsze-kasynaonline.com.pl/$1 [R=301,L]

  # Nie serwuj kodu źródłowego z katalogu deploy
  RewriteRule ^(src|scripts|text|site\.git)(/|$) - [F,L]

  # Przekierowania SEO (301). MUSZĄ być tutaj: przy document root = httpdocs
  # plik site/.htaccess nie jest przetwarzany dla nieistniejących ścieżek,
  # więc usunięte/stare URL-e trafiałyby w 404 zamiast redirectu.
  RewriteRule ^online-kasyna/?$ / [R=301,L]
  RewriteRule ^recenzje-kasyn/?$ / [R=301,L]
  RewriteRule ^recenzje/?$ / [R=301,L]
  RewriteRule ^najlepsze-kasyna-online/?$ / [R=301,L]
  RewriteRule ^polityka-cookies/?$ /polityka-plikow-cookies/ [R=301,L]
  RewriteRule ^kryteria-oceny-kasyn/?$ /kryteria-oceny/ [R=301,L]
  RewriteRule ^legalne-kasyna-online/?$ /legalne-kasyna/ [R=301,L]
  RewriteRule ^wyplacalne-kasyna-online/?$ /wyplacalne-kasyna-internetowe/ [R=301,L]
  RewriteRule ^wyplacalne-kasyna/?$ /wyplacalne-kasyna-internetowe/ [R=301,L]
  RewriteRule ^platnosci/blik/?$ /platnosci/kasyno-online-blik/ [R=301,L]
  RewriteRule ^platnosci/skrill/?$ /platnosci/kasyno-online-skrill/ [R=301,L]
  RewriteRule ^platnosci/przelewy24/?$ /platnosci/kasyno-przelewy24/ [R=301,L]
  RewriteRule ^kasyna-z-minimalnym-depozytem/kasyno-5-zl/?$ /minimalny-depozyt/5zl/ [R=301,L]
  RewriteRule ^kasyna-z-minimalnym-depozytem/kasyna-z-depozytem-za-10-zl/?$ /minimalny-depozyt/10zl/ [R=301,L]
  RewriteRule ^kasyna-z-minimalnym-depozytem/kasyno-20-zl/?$ /minimalny-depozyt/20zl/ [R=301,L]
  RewriteRule ^kasyna-z-minimalnym-depozytem/5-zl/?$ /minimalny-depozyt/5zl/ [R=301,L]
  RewriteRule ^kasyna-z-minimalnym-depozytem/10-zl/?$ /minimalny-depozyt/10zl/ [R=301,L]
  RewriteRule ^kasyna-z-minimalnym-depozytem/20-zl/?$ /minimalny-depozyt/20zl/ [R=301,L]
  RewriteRule ^kasyna-z-minimalnym-depozytem/?$ /minimalny-depozyt/ [R=301,L]

  # Domyślny plik Pleska w httpdocs — serwuj statyczną stronę z site/
  RewriteRule ^index\.html$ site/index.html [L]

  # Strona główna
  RewriteRule ^$ site/index.html [L]

  # Plik istnieje w site/ (/_next/, /images/, robots.txt, itd.)
  RewriteCond %{DOCUMENT_ROOT}/site%{REQUEST_URI} -f
  RewriteRule . site%{REQUEST_URI} [L]

  # Next export: kanoniczny URL z końcowym /. Bez tego /foo → 404 (foo/index.html nie trafia w regułę poniżej).
  RewriteCond %{DOCUMENT_ROOT}/site%{REQUEST_URI} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{DOCUMENT_ROOT}/site%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # /ścieżka/ → site/ścieżka/index.html
  RewriteCond %{DOCUMENT_ROOT}/site%{REQUEST_URI}index.html -f
  RewriteRule . site%{REQUEST_URI}index.html [L]
</IfModule>

Options -Indexes
